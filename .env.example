# Copy to .env (never commit it) or export these in your shell.
# Set only the providers you use.
XAI_API_KEY=replace-me
ANTHROPIC_API_KEY=replace-me
OPENROUTER_API_KEY=
# Optional: TypeSafe System One (Jev) post-draft screen. Without it the screen runs code checks only.
TYPESAFE_API_KEY=replace-me
# Optional: path to a bookforge config YAML
BOOKFORGE_CONFIG=
