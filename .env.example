# Copy to .env (never commit it) or export these in your shell.
# The code reads environment variables only. It does not load this file itself.
# Set only the providers you use. Never put a key in YAML, code, or git.

# Named by llm.providers.*.api_key_env in bookforge/config.py.
# xAI: the brainstorm role (web search). Required for that role.
XAI_API_KEY=
# OpenRouter: default provider for the planner, drafter, editor, and utility tiers.
OPENROUTER_API_KEY=
# Hugging Face router: the optional Gemma prose tier (llm.providers.huggingface).
# Empty until you point write/rerank at that tier. The config-init template does.
HF_TOKEN=
# Anthropic: only if a tier's provider is anthropic.
ANTHROPIC_API_KEY=
# Ollama's api_key_env is empty. No key.

# Optional. Jev (TypeSafe System One), read by bookforge/core/jev.py.
# Without it, the screen still runs code checks and skips Jev.
TYPESAFE_API_KEY=

# Optional. Read only when deai.external_detector.provider is pangram.
# The default provider is none, so this variable is not read unless you switch it.
# PANGRAM_API_KEY=

# User config YAML. Unset means ~/.bookforge/config.yaml.
# bookforge config-init writes a key-free template there, and only if the file is missing.
BOOKFORGE_CONFIG=

# Per-tier overrides. Tiers: PLANNER, DRAFTER, EDITOR, UTILITY.
# Applied when a role points at a tier. The brainstorm role names its model directly, so these do not change it.
# BOOKFORGE_PLANNER_PROVIDER=
# BOOKFORGE_PLANNER_MODEL=
# BOOKFORGE_PLANNER_REASONING_EFFORT=   # low | medium | high | none (none omits reasoning)
# BOOKFORGE_DRAFTER_PROVIDER=
# BOOKFORGE_DRAFTER_MODEL=
# BOOKFORGE_DRAFTER_REASONING_EFFORT=
# BOOKFORGE_EDITOR_PROVIDER=
# BOOKFORGE_EDITOR_MODEL=
# BOOKFORGE_EDITOR_REASONING_EFFORT=    # also set for one process by: bookforge run --edit-effort
# BOOKFORGE_UTILITY_PROVIDER=
# BOOKFORGE_UTILITY_MODEL=
# BOOKFORGE_UTILITY_REASONING_EFFORT=

# Exact KEEP/SUBTEXT line protection. Off unless the value is 1, true, yes, or on.
# FACT and EVENT hints stay on without this. See bookforge/core/protect.py.
# BOOKFORGE_PROTECT_EXACT_LINES=
